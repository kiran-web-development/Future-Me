<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer Cybernetic Orbit Ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#64D2FF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M 54,18 A 36,36 0 1,1 53.99,18 Z" />

    <!-- Secondary Accent Accentuation Ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#BF5AF2"
        android:strokeWidth="1.0"
        android:strokeLineCap="round"
        android:strokeAlpha="0.4"
        android:pathData="M 54,26 A 28,28 0 1,1 53.99,26 Z" />

    <!-- Glowing Celestial Timeline Coordinates Star -->
    <path
        android:pathData="M 54,22 Q 54,45 31,54 Q 54,63 54,86 Q 54,63 77,54 Q 54,45 54,22 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="22"
                android:endX="54"
                android:endY="86"
                android:type="linear">
                <item
                    android:color="#64D2FF"
                    android:offset="0.0" />
                <item
                    android:color="#0A84FF"
                    android:offset="0.5" />
                <item
                    android:color="#BF5AF2"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
